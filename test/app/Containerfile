# Simple test-harness container that ships the hello-world chart at /app
# and drives the helm-sidecar's HTTP API to prove the pod wiring works.
# This is a test fixture, not part of the sidecar's trust boundary, so
# unlike the sidecar image there's no need for it to be distroless/shell-
# less -- it's fine for it to be a small shell + curl image.
#
# Build context must be installers/helm/test/ (so both app/ and
# hello-world/ are visible to COPY): see ../run.sh.
FROM docker.io/library/alpine:3.20

RUN apk add --no-cache curl && \
    adduser -D -u 1000 appuser

COPY hello-world /app/hello-world
COPY app/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

USER appuser
ENTRYPOINT ["/entrypoint.sh"]
